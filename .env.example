# =====================================================================
# Gaza Building Damage Assessment AI - Environment Configuration
# =====================================================================
# Copy this file to .env and adjust variables as required for your environment.
# DO NOT commit your production .env file to public version control.

# Application Server Settings
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=False

# Security: Allowed CORS Origins (comma-separated list, e.g. https://yourdomain.com)
ALLOWED_ORIGINS=*

# Security: Upload limits in Megabytes (Protects against DoS memory attacks)
MAX_UPLOAD_SIZE_MB=10

# Model Checkpoint Path (Optional: override default auto-detection)
# MODEL_CHECKPOINT_PATH=weights/building_damage_model_v2.keras

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
